{
  "name": "boxster-book",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "node --import tsx scripts/build.ts",
    "build:preview": "node --import tsx scripts/serve.ts",
    "model:generate": "node scripts/generate-models.mjs",
    "model:posters": "node scripts/render-component-posters.mjs",
    "model:preview": "npm run model:generate && node scripts/preview-model.mjs",
    "test": "node --import tsx --test tests/*.test.js tests/*.test.ts",
    "validate": "npm run typecheck && npm run build && npm test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "d3": "7.9.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "mdast-util-to-string": "4.0.0",
    "playwright-core": "1.65.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-smartypants": "3.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vite": "8.3.7"
  }
}
